async function guardarNuevaPassword() {
  const password = document.getElementById("passwordNueva").value;
  const confirmar = document.getElementById("passwordNuevaConfirmar").value;
  const mensaje = document.getElementById("mensajeNuevaPassword");

  if (password.length < 8) {
    mensaje.textContent = "La contraseña debe tener al menos 8 caracteres.";
    return;
  }

  if (password !== confirmar) {
    mensaje.textContent = "Las contraseñas no coinciden.";
    return;
  }

  mensaje.textContent = "Actualizando contraseña...";

  const { error } = await supabaseClient.auth.updateUser({
    password: password
  });

  if (error) {
    mensaje.textContent = "No se pudo actualizar. Intenta nuevamente.";
    return;
  }

  mensaje.textContent = "¡Contraseña actualizada correctamente! 🎮";

  document.getElementById("nuevaPassword").style.display = "none";
}
async function registrarJugador() {
  const username = document.getElementById("username").value.trim().toLowerCase();
  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;
  const confirmPassword = document.getElementById("confirmPassword").value;
  const mensaje = document.getElementById("mensajeRegistro");

  if (!username || !email || !password || !confirmPassword) {
    mensaje.textContent = "Completa todos los campos.";
    return;
  }

  if (!/^[a-z0-9_]{3,20}$/.test(username)) {
    mensaje.textContent = "Usa 3 a 20 caracteres: letras, números o guion bajo.";
    return;
  }

  if (password.length < 8) {
    mensaje.textContent = "La contraseña debe tener al menos 8 caracteres.";
    return;
  }

  if (password !== confirmPassword) {
    mensaje.textContent = "Las contraseñas no coinciden.";
    return;
  }

  mensaje.textContent = "Creando tu cuenta...";

  const { data, error } = await supabaseClient.auth.signUp({
    email,
    password,
    options: {
      data: {
        username: username,
        display_name: username
      }
    }
  });

  if (error) {
    mensaje.textContent = error.message;
    return;
  }

  mensaje.textContent = "¡Cuenta creada! Revisa tu correo para verificarla.";
}
  
