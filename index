let tapConfirmados = 0;
let tapPendientes = 0;
let tapEnviando = false;
let tapTemporizador = null;

function actualizarTapUI() {
  const total = tapConfirmados + tapPendientes;
  const avance = total % 200;

  document.getElementById("contadorTap").textContent = avance;
  document.getElementById("barraTap").style.width =
    (avance / 200 * 100) + "%";
}

async function cargarProgresoTap() {
  const { data: sesion } =
    await supabaseClient.auth.getSession();

  const usuario = sesion.session?.user;

  if (!usuario) return;

  const { data, error } = await supabaseClient
    .from("tap_tap_progress")
    .select("tap_count")
    .eq("user_id", usuario.id)
    .maybeSingle();

  if (error) {
    console.error("Error cargando TAP TAP:", error);
    return;
  }

  tapConfirmados = data ? data.tap_count : 0;
  actualizarTapUI();
}

function registrarToque() {
  if (
    document.getElementById("perfilJugador").style.display === "none"
  ) {
    return;
  }

  tapPendientes++;

  actualizarTapUI();

  document.getElementById("mensajeTap").textContent =
    "¡Sigue tocando! ⚡";

  clearTimeout(tapTemporizador);

  if (tapPendientes >= 10) {
    enviarToquesTap();
  } else {
    tapTemporizador = setTimeout(() => {
      enviarToquesTap();
    }, 800);
  }
}

async function enviarToquesTap() {
  if (tapEnviando || tapPendientes === 0) return;

  clearTimeout(tapTemporizador);

  tapEnviando = true;

  const cantidad = Math.min(tapPendientes, 200);
  tapPendientes -= cantidad;

  const mensaje = document.getElementById("mensajeTap");

  mensaje.textContent = "Guardando tus toques...";

  const { data, error } = await supabaseClient.rpc(
    "register_tap_batch",
    { p_taps: cantidad }
  );

  if (error) {
    tapPendientes += cantidad;
    mensaje.textContent =
      "No se pudieron guardar los toques. Intenta nuevamente.";
    console.error("Error TAP TAP:", error);
  } else {
    tapConfirmados = data.remaining_taps;

    if (data.capsules_earned > 0) {
      mensaje.textContent =
        "🎉 ¡Ganaste " + data.capsules_earned +
        " Cápsula(s) del Poder!";
      await cargarSaldoCapsulas();
    } else {
      mensaje.textContent = "¡Toques guardados correctamente! ⚡";
    }
  }

  tapEnviando = false;
  actualizarTapUI();

  if (tapPendientes > 0 && !error) {
    enviarToquesTap();
  }
}
  
